rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedStonyBrookUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@stonybrook[.]edu$');
    }

    function owns(userId) {
      return isVerifiedStonyBrookUser() && request.auth.uid == userId;
    }

    // Vehicle photos and plates are private. Only the trusted demo callable writes them.
    match /users/{userId}/vehicles/{vehicleId} {
      allow read: if owns(userId) && vehicleId == 'primary';
      allow write: if false;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'firstName',
          'role',
          'bio',
          'photoBase64',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.role in ['driver', 'rider', 'both']
        && (!request.resource.data.keys().hasAny(['bio']) || (
          request.resource.data.bio is string
          && request.resource.data.bio.size() > 0
          && request.resource.data.bio.size() <= 160))
        && (!request.resource.data.keys().hasAny(['photoBase64']) || (
          request.resource.data.photoBase64 is string
          && request.resource.data.photoBase64.size() > 0
          && request.resource.data.photoBase64.size() <= 250000
          && request.resource.data.photoBase64.matches('^/9j/.*$')))
        && request.resource.data.updatedAt is timestamp;
    }

    function validPublicProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'ownerId', 'displayName', 'role', 'bio', 'photoBase64', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.ownerId == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.role in ['driver', 'rider', 'both']
        && (!request.resource.data.keys().hasAny(['bio']) || (
          request.resource.data.bio is string
          && request.resource.data.bio.size() > 0
          && request.resource.data.bio.size() <= 160))
        && (!request.resource.data.keys().hasAny(['photoBase64']) || (
          request.resource.data.photoBase64 is string
          && request.resource.data.photoBase64.size() > 0
          && request.resource.data.photoBase64.size() <= 250000
          && request.resource.data.photoBase64.matches('^/9j/.*$')))
        && request.resource.data.updatedAt is timestamp;
    }

    function validBlock(userId, targetId) {
      return request.resource.data.keys().hasOnly(['targetId', 'targetName', 'createdAt'])
        && request.resource.data.targetId == targetId
        && targetId is string
        && targetId != userId
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() > 0
        && request.resource.data.targetName.size() <= 80
        && request.resource.data.createdAt is timestamp;
    }

    function validReport() {
      return request.resource.data.keys().hasAll(['reporterId', 'targetId', 'targetName', 'reason', 'createdAt'])
        && request.resource.data.keys().hasOnly(['reporterId', 'targetId', 'targetName', 'reason', 'details', 'createdAt'])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() > 0
        && request.resource.data.targetName.size() <= 80
        && request.resource.data.reason in [
          'harassment',
          'unsafe_driving',
          'no_show',
          'inappropriate_behavior',
          'scam_or_fraud',
          'other'
        ]
        && (!request.resource.data.keys().hasAny(['details']) || (
          request.resource.data.details is string
          && request.resource.data.details.size() <= 500))
        && request.resource.data.createdAt is timestamp;
    }

    function validPrivacyArea() {
      return request.resource.data.startArea is map
        && request.resource.data.startArea.keys().hasOnly(['center', 'radiusMiles', 'label'])
        && request.resource.data.startArea.center is map
        && request.resource.data.startArea.center.keys().hasOnly(['latitude', 'longitude'])
        && request.resource.data.startArea.center.latitude is number
        && request.resource.data.startArea.center.latitude >= -90
        && request.resource.data.startArea.center.latitude <= 90
        && request.resource.data.startArea.center.longitude is number
        && request.resource.data.startArea.center.longitude >= -180
        && request.resource.data.startArea.center.longitude <= 180
        && request.resource.data.startArea.radiusMiles == 2
        && request.resource.data.startArea.label is string
        && request.resource.data.startArea.label.size() > 0
        && request.resource.data.startArea.label.size() <= 120;
    }

    function validLocalTime(t) { return t == null || (t is int && t >= 0 && t < 1440); }
    function validDay(d) {
      return d is map && d.keys().hasAll(['day', 'mode', 'arriveBy', 'leaveAt'])
        && d.keys().hasOnly(['day', 'mode', 'arriveBy', 'leaveAt', 'startAt'])
        && d.day in ['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun']
        && d.mode in ['drive', 'ride', 'either']
        && validLocalTime(d.arriveBy) && validLocalTime(d.leaveAt)
        && (d.arriveBy != null || d.leaveAt != null)
        && (!d.keys().hasAny(['startAt']) || (validLocalTime(d.startAt)
          && (d.startAt == null || d.arriveBy == null || ((d.startAt < d.arriveBy + 30) && (d.leaveAt == null || d.startAt < d.leaveAt)))));
    }

    function validCommute(userId) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'ownerId',
          'startArea',
          'startPoint',
          'discoveryEnabled',
          'campusLot',
          'riderDropoffPreference',
          'days',
          'seats',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.ownerId == userId
        && (!request.resource.data.keys().hasAny(['discoveryEnabled']) || request.resource.data.discoveryEnabled is bool)
        && (!request.resource.data.keys().hasAny(['startPoint']) || (
          request.resource.data.startPoint is map
          && request.resource.data.startPoint.keys().hasAll(['latitude', 'longitude'])
          && request.resource.data.startPoint.keys().hasOnly(['latitude', 'longitude'])
          && request.resource.data.startPoint.latitude is number
          && request.resource.data.startPoint.latitude >= -90 && request.resource.data.startPoint.latitude <= 90
          && request.resource.data.startPoint.longitude is number
          && request.resource.data.startPoint.longitude >= -180 && request.resource.data.startPoint.longitude <= 180))
        && (!request.resource.data.keys().hasAny(['riderDropoffPreference']) || request.resource.data.riderDropoffPreference == 'any')
        && validPrivacyArea()
        && request.resource.data.campusLot in [
          'westSide',
          'eastSide',
          'tabler',
          'roth',
          'lot40',
          'other'
        ]
        && request.resource.data.days is list
        && request.resource.data.days.size() > 0
        && request.resource.data.days.size() <= 7
        && validDay(request.resource.data.days[0])
        && (request.resource.data.days.size() < 2 || validDay(request.resource.data.days[1]))
        && (request.resource.data.days.size() < 3 || validDay(request.resource.data.days[2]))
        && (request.resource.data.days.size() < 4 || validDay(request.resource.data.days[3]))
        && (request.resource.data.days.size() < 5 || validDay(request.resource.data.days[4]))
        && (request.resource.data.days.size() < 6 || validDay(request.resource.data.days[5]))
        && (request.resource.data.days.size() < 7 || validDay(request.resource.data.days[6]))
        && (!request.resource.data.keys().hasAny(['seats'])
          || (request.resource.data.seats is int
            && request.resource.data.seats >= 1
            && request.resource.data.seats <= 6))
        && request.resource.data.updatedAt is timestamp;
    }

    function validWindow(w) {
      return w is map && w.keys().hasOnly(['earliest', 'latest'])
        && w.earliest is int && w.latest is int
        && w.earliest >= 0 && w.latest < 1440 && w.earliest <= w.latest;
    }

    function validMatchingSetup(userId) {
      let d = request.resource.data;
      return d.keys().hasAll(['schemaVersion', 'ownerId', 'revision', 'commuteKey',
          'mode', 'active', 'optIn', 'campusLot', 'weekdays', 'pointId',
          'startWindow', 'arrivalWindow', 'seatsRequested', 'maxDetourSeconds',
          'maxExtraRideSeconds', 'accessWalkSeconds', 'egressWalkSeconds',
          'maxAccessWalkSeconds', 'maxEgressWalkSeconds', 'updatedAt'])
        && d.keys().hasOnly(['schemaVersion', 'ownerId', 'revision', 'commuteKey',
          'mode', 'active', 'optIn', 'campusLot', 'weekdays', 'pointId',
          'startWindow', 'arrivalWindow', 'seatsRequested', 'maxDetourSeconds',
          'maxExtraRideSeconds', 'accessWalkSeconds', 'egressWalkSeconds',
          'maxAccessWalkSeconds', 'maxEgressWalkSeconds', 'updatedAt'])
        && d.schemaVersion == 1 && d.ownerId == userId
        && d.revision is string && d.revision.size() > 0 && d.revision.size() <= 80
        && d.commuteKey is string && d.commuteKey.size() > 0 && d.commuteKey.size() <= 4000
        && d.mode in ['driver', 'rider'] && d.active is bool && d.optIn is bool
        && d.campusLot in ['westSide', 'eastSide', 'tabler', 'roth', 'lot40']
        && d.pointId in ['stony-brook-station', 'port-jefferson-station', 'smithtown-station', 'jamaica-station']
        && d.weekdays is list && d.weekdays.size() > 0 && d.weekdays.size() <= 7
        && d.weekdays.hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
        && d.weekdays.toSet().size() == d.weekdays.size()
        && validWindow(d.startWindow) && validWindow(d.arrivalWindow)
        && d.seatsRequested is int && d.seatsRequested >= 1 && d.seatsRequested <= 6
        && d.maxDetourSeconds is int && d.maxDetourSeconds >= 0 && d.maxDetourSeconds <= 21600
        && d.maxExtraRideSeconds is int && d.maxExtraRideSeconds >= 0 && d.maxExtraRideSeconds <= 21600
        && d.accessWalkSeconds is int && d.accessWalkSeconds >= 0 && d.accessWalkSeconds <= 7200
        && d.egressWalkSeconds is int && d.egressWalkSeconds >= 0 && d.egressWalkSeconds <= 7200
        && d.maxAccessWalkSeconds is int && d.maxAccessWalkSeconds >= 0 && d.maxAccessWalkSeconds <= 7200
        && d.maxEgressWalkSeconds is int && d.maxEgressWalkSeconds >= 0 && d.maxEgressWalkSeconds <= 7200
        && d.updatedAt == request.time;
    }

    // Private matching inputs; the callable service performs candidate discovery.
    match /matchingSetups/{userId} {
      allow read, delete: if owns(userId);
      allow create: if owns(userId) && validMatchingSetup(userId);
      allow update: if owns(userId) && validMatchingSetup(userId)
        && request.resource.data.revision != resource.data.revision;
    }

    // Status and reservation writes are server-only. Queries must constrain participantIds.
    match /rideRequests/{requestId} {
      allow read: if isVerifiedStonyBrookUser()
        && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }

    // Chat participants are established by the trusted matching callable.
    match /chats/{chatId} {
      allow read: if isVerifiedStonyBrookUser()
        && request.auth.uid in resource.data.participantIds;
      allow write: if false;
      match /messages/{messageId} {
        allow read: if isVerifiedStonyBrookUser()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
        allow write: if false;
      }
    }

    // Exact routing points are released only after acceptance, to that ride's participants.
    match /ridePickups/{requestId} {
      allow read: if isVerifiedStonyBrookUser()
        && get(/databases/$(database)/documents/rideRequests/$(requestId)).data.status == 'ACCEPTED'
        && request.auth.uid in get(/databases/$(database)/documents/rideRequests/$(requestId)).data.participantIds;
      allow write: if false;
    }

    // Settle-up records are created and confirmed by trusted callables; participants read them.
    match /settlements/{settlementId} {
      allow read: if isVerifiedStonyBrookUser()
        && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }

    // Payment usernames: the owner reads their own; riders get them through a callable that
    // checks they actually rode with this driver.
    match /paymentHandles/{userId} {
      allow read: if owns(userId);
      allow write: if false;
    }

    // A driver's price adjustment for one rider: both can read it; only the callable writes.
    match /priceAdjustments/{pairId} {
      allow read: if isVerifiedStonyBrookUser()
        && request.auth.uid in resource.data.participantIds;
      allow write: if false;
    }

    // This week's fuel prices are public reference data, written only by the weekly refresh.
    match /pricing/{docId} {
      allow read: if isVerifiedStonyBrookUser();
      allow write: if false;
    }

    // Temporary M2 heartbeat. It remains read-only and exposes no user document.
    match /commutes/{commuteId} {
      allow read: if commuteId == 'sample-commute-001';
      allow write: if false;
    }

    match /users/{userId} {
      allow read, delete: if owns(userId);
      allow create, update: if owns(userId) && validProfile();

      match /commuteDays/{date} {
        allow read: if owns(userId);
        // Trusted action checks existing commitments atomically.
        allow write: if false;
      }

      match /commutes/{commuteId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId) && validCommute(userId);
      }

      match /blockedUsers/{targetId} {
        allow read, delete: if owns(userId);
        allow create, update: if owns(userId) && validBlock(userId, targetId);
      }
    }

    match /publicProfiles/{userId} {
      allow read: if isVerifiedStonyBrookUser();
      allow create, update: if owns(userId) && validPublicProfile(userId);
      allow delete: if owns(userId);
    }

    // Reports submitted by verified users for moderation review; clients cannot read or modify submitted reports.
    match /reports/{reportId} {
      allow create: if isVerifiedStonyBrookUser() && validReport();
      allow read, update, delete: if false;
    }
  }
}
