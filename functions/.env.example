# Limited two-account demo. All matching/preview calls share the distributed scheduler.
OSRM_BASE_URL=https://router.project-osrm.org

# Optional fixed-departure calendar forecasts. Use --traffic-eta with a private key.
# ROUTING_PROVIDER=tomtom
# TOMTOM_API_KEY=your_backend_only_key

# Optional dataset-local monthly TomTom attempt budget: 1..20000 (default 18000).
# TOMTOM_MONTHLY_REQUEST_LIMIT=18000
