# Firebase public client configuration. Copy this file to .env and supply the
# values for the development Firebase project. EXPO_PUBLIC_ values are embedded
# in the application bundle and must never contain private or administrative
# credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Developer Route Planner; never place credentials here.
# Optional non-public provider for isolated developer tools; public demo calls use the callable.
EXPO_PUBLIC_OSRM_BASE_URL=
# Maximum provider snap distance accepted for confirmed Find Riders Demo pickups.
EXPO_PUBLIC_RIDER_DEMO_MAX_SNAP_METERS=75

# Address/place search. Photon uses OpenStreetMap data and needs no client secret.
# The public demo server is for reasonable prototype traffic, not guaranteed production use.
EXPO_PUBLIC_GEOCODING_BASE_URL=https://photon.komoot.io

# Local emulator host, development builds only. Android emulator: 10.0.2.2
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=

# For the shared local M3 demo, use scripts/start-local-demo.mjs instead of editing
# these cloud values. See ../docs/local-m3-demo.md (demo-seawolf-rides + Mac LAN host).
