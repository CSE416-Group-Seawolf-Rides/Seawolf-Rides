# Firebase public client configuration. Copy this file to .env and supply the
# values for the development Firebase project. EXPO_PUBLIC_ values are embedded
# in the application bundle and must never contain private or administrative
# credentials.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Development Route Planner. Public demo endpoint for light manual testing only.
# Override with another compatible OSRM server; never place credentials here.
EXPO_PUBLIC_OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_NAVIGATION_ANDROID_API_KEY=
GOOGLE_NAVIGATION_IOS_API_KEY=

# Address/place search. Photon uses OpenStreetMap data and needs no client secret.
# The public demo server is for reasonable prototype traffic, not guaranteed production use.
EXPO_PUBLIC_GEOCODING_BASE_URL=https://photon.komoot.io
