{
  "name": "mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "engines": {
    "node": "24.21.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.22",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "1.20.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "doctor": "expo-doctor",
    "lint": "expo lint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/node-test/register-ts-resolver.mjs --test",
    "test:firebase-auth": "npx --yes firebase-tools@15.33.0 emulators:exec --config ../firebase.json --only auth --project demo-seawolf-rides \"node --test integration/firebase-auth.integration.mjs\"",
    "test:firestore-rules": "npx --yes firebase-tools@15.33.0 emulators:exec --config ../firebase.json --only firestore --project demo-seawolf-rides \"node --import ./scripts/node-test/register-ts-resolver.mjs --test --test-concurrency=1 integration/firestore-rules.integration.mjs integration/account-support.integration.mjs\"",
    "build": "expo export --platform android --output-dir dist",
    "test:matching": "node scripts/run-matching-emulators.mjs",
    "seed:demo": "node --import ./scripts/node-test/register-ts-resolver.mjs scripts/seed-demo-data.mjs",
    "test:ride-presentation": "npx --yes firebase-tools@15.33.0 emulators:exec --config ../firebase.json --only auth,firestore --project demo-seawolf-rides \"node --import ./scripts/node-test/register-ts-resolver.mjs --test integration/ride-presentation.integration.mjs\""
  },
  "private": true
}
